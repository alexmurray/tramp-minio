(ert-deftest tramp-minio-copy-file-semantics ()
  (skip-unless (and (executable-find "python3") (getenv "TRAMP_MINIO_FAKE_MC")))
  (let ((tramp-minio-program (getenv "TRAMP_MINIO_FAKE_MC"))
        (tramp-minio--checked-program nil)
        (tramp-minio--cache (make-hash-table :test 'equal))
        (tramp-minio-read-only nil)
        (tramp-minio-allow-overwrite t)
        (process-environment (copy-sequence process-environment))
        (state (make-temp-file "tramp-minio-cp-" t))
        (loc (make-temp-file "tramp-minio-loc-")))
    (unwind-protect
        (progn
          (setenv "TRAMP_MINIO_FAKE_STATE" state)
          ;; Integer ok prompts once, not twice.
          (let ((prompts 0))
            (cl-letf (((symbol-function 'yes-or-no-p)
                       (lambda (&rest _) (cl-incf prompts) t)))
              (copy-file tramp-minio-test-name loc 1 t)
              (should (= prompts 1))))
          (should (equal (with-temp-buffer (insert-file-contents loc) (buffer-string)) "test"))
          (should (time-equal-p (file-attribute-modification-time (file-attributes loc))
                                (date-to-time "2026-01-01T00:00:00Z")))
          ;; file-already-exists preserves human-readable error message.
          (let ((err (should-error (copy-file tramp-minio-test-name loc nil) :type 'file-already-exists)))
            (should (string-match-p "File already exists" (error-message-string err))))
          ;; Local -> MinIO -> MinIO copy.
          (copy-file loc "/minio:lab:/bucket/copied.txt" t)
          (copy-file "/minio:lab:/bucket/copied.txt" "/minio:lab:/bucket/copied2.txt" t)
          (should (equal (with-temp-buffer
                           (insert-file-contents "/minio:lab:/bucket/copied2.txt")
                           (buffer-string))
                         "test"))
          ;; Copying to self signals file-error.
          (should-error (copy-file tramp-minio-test-name "/minio:lab:/bucket/" t) :type 'file-error))
      (delete-file loc)
      (delete-directory state t))))

(ert-deftest tramp-minio-mkdir-bucket-and-parents ()
  (skip-unless (and (executable-find "python3") (getenv "TRAMP_MINIO_FAKE_MC")))
  (let ((tramp-minio-program (getenv "TRAMP_MINIO_FAKE_MC"))
        (tramp-minio--checked-program nil)
        (tramp-minio--cache (make-hash-table :test 'equal))
        (tramp-minio-read-only nil)
        (process-environment (copy-sequence process-environment))
        (state (make-temp-file "tramp-minio-mb-" t)))
    (unwind-protect
        (progn
          (setenv "TRAMP_MINIO_FAKE_STATE" state)
          (make-directory "/minio:lab:/newbucket/")
          (should (file-directory-p "/minio:lab:/newbucket/"))
          ;; Creating existing bucket with PARENTS non-nil succeeds.
          (make-directory "/minio:lab:/newbucket/" t)
          ;; Sub-prefixes remain unsupported.
          (should-error (make-directory "/minio:lab:/newbucket/sub/" t) :type 'file-error))
      (delete-directory state t))))

