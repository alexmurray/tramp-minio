(ert-deftest tramp-minio-write-file-and-prefix-writable ()
  (skip-unless (and (executable-find "python3") (getenv "TRAMP_MINIO_FAKE_MC")))
  (let ((tramp-minio-program (getenv "TRAMP_MINIO_FAKE_MC"))
        (tramp-minio--checked-program nil)
        (tramp-minio--cache (make-hash-table :test 'equal))
        (tramp-minio-read-only nil)
        (tramp-minio-allow-overwrite t)
        (process-environment (copy-sequence process-environment))
        (state (make-temp-file "tramp-minio-wf-" t))
        buffer)
    (unwind-protect
        (progn
          (setenv "TRAMP_MINIO_FAKE_STATE" state)
          (should (file-writable-p "/minio:lab:/bucket/newdir/new.txt"))
          (write-region "in new prefix\n" nil "/minio:lab:/bucket/newdir/new.txt")
          (with-temp-buffer
            (insert-file-contents "/minio:lab:/bucket/newdir/new.txt")
            (should (equal (buffer-string) "in new prefix\n")))
          (setq buffer (generate-new-buffer " *wf-test*"))
          (with-current-buffer buffer
            (insert "via write-file\n")
            (write-file "/minio:lab:/bucket/via-wf.txt")
            (should backup-inhibited)
            (should-not auto-save-default)
            (should tramp-minio--needs-revert)
            (should-not (buffer-modified-p)))
          (with-temp-buffer
            (insert-file-contents "/minio:lab:/bucket/via-wf.txt")
            (should (equal (buffer-string) "via write-file\n"))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-directory state t))))

