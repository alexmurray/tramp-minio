(ert-deftest tramp-minio-relative-expand-and-dir-inodes ()
  (tramp-minio-test-with-alias
   (let ((default-directory "/minio:lab:/bucket/"))
     (should-error (expand-file-name "a//b") :type 'file-error)
     (should (equal (expand-file-name "/etc/passwd") "/etc/passwd")))
   (cl-letf (((symbol-function 'tramp-minio--run)
              (lambda (_cmd target)
                (cond ((equal target "lab/") '(((key . "bucket/") (type . "folder"))))
                      ((equal target "lab/bucket/") '(((key . "file.txt") (type . "file") (size . 4))))
                      (t nil)))))
     (let* ((dir-attrs (file-attributes "/minio:lab:/bucket/"))
            (entries (directory-files-and-attributes "/minio:lab:/bucket/"))
            (dot-attrs (cdr (assoc "." entries)))
            (rel-entries (let ((default-directory "/minio:lab:/bucket/"))
                           (directory-files-and-attributes "."))))
       (should (equal (file-attribute-inode-number dir-attrs)
                      (file-attribute-inode-number dot-attrs)))
       (should (assoc ".." rel-entries))))))

(ert-deftest tramp-minio-insert-directory-switches ()
  (tramp-minio-test-with-alias
   (cl-letf (((symbol-function 'tramp-minio--run)
              (lambda (&rest _) '(((key . "file.txt") (type . "file") (size . 4))))))
     (with-temp-buffer
       (insert-directory "/minio:lab:/bucket/" "" nil t)
       (should (equal (string-trim (buffer-string)) "file.txt")))
     (with-temp-buffer
       (insert-directory "/minio:lab:/bucket/" "-al" nil t)
       (should (string-match-p "^-.* file\\.txt$" (buffer-string)))
       (insert "prefix")
       (let ((before (buffer-string)))
         (save-excursion (insert "suffix"))
         (insert-directory "/minio:lab:/bucket/" "--all" nil t)
         (should (equal (buffer-string) (concat before ".\n..\nfile.txt\nsuffix"))))))))

